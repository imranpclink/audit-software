<%- include('partials/AUDIT_head', { title: 'Annual Audit Plan' }) %>
<div class="AUDIT_pagehead"><h1><%= t('Annual Audit Plan') %></h1><% if (canPlan) { %><a class="AUDIT_btn" href="/plans/new">+ <%= lang === 'bn' ? 'নতুন পরিকল্পনা' : 'New plan' %></a><% } %></div>
<div class="AUDIT_panel AUDIT_scroll">
<% if (!rows.length) { %><p class="AUDIT_muted"><%= t('Nothing here yet.') %></p><% } else { %>
<table class="AUDIT_grid">
  <tr><th><%= t('Plan no.') %></th><th><%= t('Plan year') %></th><th><%= t('Period') %></th><th><%= t('Audit level') %></th><th class="AUDIT_num"><%= t('Branches') %></th><th><%= t('Submitted by') %></th><th><%= t('Status') %></th><th></th></tr>
  <% for (const p of rows) { %>
  <tr><td><a href="/plans/<%= p.plan_id %>"><%= p.plan_no %></a></td><td><%= digits(p.plan_year) %></td><td><%= p.period %></td><td><%= st(p.audit_level) %></td><td class="AUDIT_num"><%= digits(p.items) %></td><td><%= p.username %></td><td><%- badge(p.status) %></td><td><a href="/reports/plan/<%= p.plan_id %>"><%= t('Print') %></a></td></tr>
  <% } %>
</table>
<% } %>
</div>
<%- include('partials/AUDIT_foot') %>
