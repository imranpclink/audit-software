<%- include('partials/AUDIT_head', { title: 'Reports' }) %>
<h1><%= t('Reports') %></h1>
<p class="AUDIT_muted"><%= lang === 'bn' ? 'প্রতিটি রিপোর্ট বাংলা বা ইংরেজিতে প্রিন্ট বা পিডিএফ করা যায়।' : 'Every report prints or saves as PDF in Bangla or English.' %></p>
<div class="AUDIT_two">
  <div class="AUDIT_panel">
    <h3><%= lang === 'bn' ? 'সারাংশ রিপোর্ট' : 'Summary reports' %></h3>
    <ul>
      <li><a href="/reports/observations"><%= t('Observation Register') %></a> (R7)</li>
      <li><a href="/reports/pending"><%= t('Pending Response / Overdue') %></a> (R9)</li>
      <li><a href="/reports/ratios"><%= t('Branch Ratio vs PKSF Standard') %></a> · <%= t('Branch Risk Rating') %> (R14, R15)</li>
    </ul>
    <h3><%= t('Annual Audit Plan') %> (R1)</h3>
    <ul><% for (const p of plans) { %><li><a href="/reports/plan/<%= p.plan_id %>"><%= p.plan_no %></a> <%- badge(p.status) %></li><% } %></ul>
  </div>
  <div class="AUDIT_panel AUDIT_scroll">
    <h3><%= lang === 'bn' ? 'অডিটভিত্তিক রিপোর্ট' : 'Per-audit reports' %></h3>
    <table class="AUDIT_grid">
      <tr><th><%= t('Audit no.') %></th><th><%= t('Office') %></th><th><%= t('Status') %></th><th></th></tr>
      <% for (const a of audits) { const started = !['DRAFT','PENDING_APPROVAL','RETURNED','REJECTED','APPROVED'].includes(a.status); %>
      <tr><td class="AUDIT_nowrap"><%= a.audit_no %></td><td><%= nm(a, 'office') %></td><td><%- badge(a.status) %></td>
        <td class="AUDIT_small">
          <% if (a.memo_no) { %><a href="/reports/order-letter/<%= a.audit_id %>"><%= lang === 'bn' ? 'আদেশপত্র' : 'Order letter' %></a><% } %>
          <% if (started) { %> · <a href="/reports/audit/<%= a.audit_id %>"><%= t('Audit Report') %></a><% } %>
          <% if (['UNDER_RESPONSE','CLOSED'].includes(a.status)) { %> · <a href="/reports/show-cause/<%= a.audit_id %>"><%= lang === 'bn' ? 'কারণ দর্শানো' : 'Show-cause' %></a><% } %>
        </td></tr>
      <% } %>
    </table>
  </div>
</div>
<%- include('partials/AUDIT_foot') %>
